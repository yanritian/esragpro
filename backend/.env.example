# Environment variables for local development

# App
DEBUG=true

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX_NAME=knowledge_base

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/esragpro

# Redis
REDIS_URL=redis://localhost:6379/0

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
# Secure Compose mounts the published model volume at:
# /opt/esragpro/models/BAAI--bge-m3/5617a9f61b028005a4858fdac845db406aefb181
# Secure Compose sets EMBEDDING_MODEL_PATH=/opt/esragpro/models/BAAI--bge-m3/5617a9f61b028005a4858fdac845db406aefb181
# and enables EMBEDDING_LOCAL_FILES_ONLY=true, EMBEDDING_OFFLINE=true,
# HF_HUB_OFFLINE=1, and TRANSFORMERS_OFFLINE=1.
# Optional offline import source for install.sh (host path only):
# EMBEDDING_MODEL_SOURCE=/absolute/path/to/huggingface-cache

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_EXPIRE_MINUTES=1440

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# Secure Compose runs one worker with a 6G limit and 3G reservation.
UVICORN_WORKERS=1
