# ============================================================
# esRAGPro environment template
# Copy to .env and edit values for your deployment.
# ============================================================

# ------------------------------------------------------------
# Elasticsearch
# ------------------------------------------------------------
ES_HOST=http://localhost:9200
ES_INDEX_NAME=knowledge_base
# ES_USER=
# ES_PASSWORD=

# ------------------------------------------------------------
# Embedding model
# ------------------------------------------------------------
# local | qwen_api | zhipu_api | ollama
#
# ollama (RECOMMENDED for local/private deployments, pairs with the slim image):
#   - Requires Ollama running (default http://127.0.0.1:11434) and the model pulled:
#       ollama pull bge-m3
#   - Same 1024 dims as BAAI/bge-m3, vectors are normalized by the backend
#   - Set EMBEDDING_MODEL=bge-m3 (HF-style "BAAI/bge-m3" also works, auto-mapped)
#   - No torch in the backend image, no API cost, data never leaves the machine
#
# IMPORTANT (image size / memory): the default backend Dockerfile is SLIM
# (~600MB, no torch). It requires a remote provider:
#   EMBEDDING_PROVIDER=qwen_api  (DashScope text-embedding-v3)
#   EMBEDDING_PROVIDER=zhipu_api (GLM embedding-3)
#   EMBEDDING_API_KEY=...
# For in-process local embeddings (BAAI/bge-m3 via torch), build the image
# with:  docker build --build-arg LOCAL_EMBEDDING=1 .   (~1.5GB image)
# and keep EMBEDDING_PROVIDER=local.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=your_api_key
# Ollama provider settings (EMBEDDING_PROVIDER=ollama):
# EMBEDDING_OLLAMA_URL=http://127.0.0.1:11434
# EMBEDDING_OLLAMA_TIMEOUT_S=60
# Secure Compose materializes this pinned revision at:
# /opt/esragpro/models/BAAI--bge-m3/5617a9f61b028005a4858fdac845db406aefb181
# It sets EMBEDDING_MODEL_PATH=/opt/esragpro/models/BAAI--bge-m3/5617a9f61b028005a4858fdac845db406aefb181
# with EMBEDDING_LOCAL_FILES_ONLY=true, EMBEDDING_OFFLINE=true,
# HF_HUB_OFFLINE=1, and TRANSFORMERS_OFFLINE=1.
# Optional offline import source for install.sh (host path only):
# EMBEDDING_MODEL_SOURCE=/absolute/path/to/huggingface-cache

# ------------------------------------------------------------
# RRF (Reciprocal Rank Fusion)
# ------------------------------------------------------------
RRF_K=60
RERANK_ENABLED=false

# ------------------------------------------------------------
# PostgreSQL (authoritative store)
# ------------------------------------------------------------
DB_USER=postgres
# Development placeholder — replace with a strong password in
# production. The value is intentionally ASCII so it parses
# cleanly in every shell and compose interpolation context.
DB_PASSWORD=change-me-strong-password
# DATABASE_URL is derived from DB_USER / DB_PASSWORD by default.
# Override the whole string only when the backend connects to a
# remotely-hosted Postgres with a different credential layout.
DATABASE_URL=postgresql+asyncpg://${DB_USER:-postgres}:${DB_PASSWORD:-change-me-strong-password}@localhost:5432/esragpro

# ------------------------------------------------------------
# Redis (hot state / cache)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Neo4j (optional knowledge-graph projector)
# Disabled by default. The memory compose profile keeps this
# false; flip to true only when a Neo4j instance is deployed.
# MinIO and Neo4j are outside the memory compose profile —
# see docs/memory-stack-runbook.md for the boundary.
# ------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_ENABLED=false

# ------------------------------------------------------------
# MinIO (optional blob/evidence store)
# Required ONLY by the full docker-compose.yml (production
# stack). The memory compose profile does not start MinIO —
# see docs/memory-stack-runbook.md for the boundary.
#
# The main compose file uses required interpolation
# (`${MINIO_ACCESS_KEY:?…}`), so these placeholders MUST be
# uncommented before `docker compose -f docker-compose.yml up`.
# Values below are development placeholders — replace with real
# credentials before any non-local deployment.
# ------------------------------------------------------------
MINIO_ACCESS_KEY=change-me-minio-access
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET_NAME=memory-evidence
MINIO_SECURE=false

# ------------------------------------------------------------
# JWT / authentication
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-jwt-secret-replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# LLM provider
# Supported: deepseek | openai | zhipu | qwen | moonshot
# ------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------
# Upload / server
# ------------------------------------------------------------
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
HTTP_PORT=80
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Backend worker capacity (P10-G)
# Uvicorn worker process count for the backend API container.
# The default stays 1 (the long-standing single-worker behavior);
# raise it only when the deployment host has spare CPU/memory and
# the measured read path is worker-bound. This is a deployment
# capacity knob only - it does not change retrieval or evidence
# semantics.
# ------------------------------------------------------------
UVICORN_WORKERS=1
# Secure Compose enforces one worker and reserves 3G with a 6G limit for
# the backend model process. These are container resources, not host defaults.

# ------------------------------------------------------------
# Memory candidate sources (P2 runtime)
# Opt-in feature flag. The memory compose profile overrides
# this to `true` for the backend service only. The global
# default stays false so local/host runs remain unaffected.
# ------------------------------------------------------------
MEMORY_CANDIDATE_SOURCES_ENABLED=false
MEMORY_CANDIDATE_SOURCE_TIMEOUT_S=2.0

# World-memory candidate readers (P6-G2)
WORLD_MEMORY_CANDIDATE_SOURCES_ENABLED=false
WORLD_MEMORY_ELASTICSEARCH_INDEX_NAME=world-memory-history-v1
WORLD_MEMORY_NEO4J_DATABASE=neo4j
WORLD_MEMORY_CANDIDATE_SOURCE_TIMEOUT_S=2.0

# Immutable world-memory event-history retrieval (P9-D3, fail-closed)
WORLD_MEMORY_EVENT_HISTORY_ENABLED=false
WORLD_MEMORY_EVENT_HISTORY_INDEX_NAME=world-memory-events-v2
